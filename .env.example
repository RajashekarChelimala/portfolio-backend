# ==========================================
# Portfolio Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Client Application URL
REACT_APP_FRONTEND_URL=http://localhost:3000

# Database Connection (MongoDB Atlas URI)
DATABASE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_super_secret_jwt_access_token_128_chars
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_token_128_chars

# Server Administration Key (Used for initial /admin-register enrollment)
ADMIN_KEY=your_secret_admin_enrollment_key_here

# Google reCAPTCHA v2 / v3
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Automated Email Notifications (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Cloudinary Cloud Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
